<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="24dp" android:gravity="center_vertical"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <TextView android:text="@string/app_name" android:textSize="28sp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"/>
    <TextView android:text="@string/connect_subtitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:paddingBottom="16dp"/>

    <EditText android:id="@+id/etIp" android:hint="@string/ip_hint"
        android:inputType="text" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <Spinner android:id="@+id/spDevices"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <Button android:id="@+id/btnDiscover" android:text="@string/discover"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <Button android:id="@+id/btnSend" android:text="@string/control_wifi"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <Button android:id="@+id/btnBt" android:text="@string/control_bt"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <Switch android:id="@+id/swBtLegacy" android:text="@string/bt_legacy"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <TextView android:text="@string/or_separator" android:gravity="center"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp"/>

    <Button android:id="@+id/btnReceive" android:text="@string/receive"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <TextView android:id="@+id/tvStatus" android:text="@string/status_idle"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp"/>

    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp">
        <Button android:id="@+id/btnExport" android:text="@string/export_profiles"
            android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnImport" android:text="@string/import_profiles"
            android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp">
        <Button android:id="@+id/btnLang" android:text="@string/pick_language"
            android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
    </LinearLayout>

    <Switch android:id="@+id/swImmersive" android:text="@string/immersive"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
