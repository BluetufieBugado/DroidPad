# Copie este arquivo para "keystore.properties" (nesta mesma pasta, android/) e preencha.
# O arquivo keystore.properties e o .jks NUNCA devem ir para o git (ja estao no .gitignore).
#
# Use caminho com barras normais (/) mesmo no Windows, ou barras duplas (\\).
# Guarde o .jks FORA da pasta do projeto.
storeFile=C:/Users/SEU_USUARIO/keys/droidpad-release.jks
storePassword=SENHA_DO_KEYSTORE
keyAlias=droidpad
keyPassword=SENHA_DA_CHAVE
